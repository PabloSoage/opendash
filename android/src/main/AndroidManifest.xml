<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The bridge talks to the SM3 over its own Wi-Fi access point and
         listens on the loopback for the phone app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Two jobs. Asking the system to join the adapter's access point needs
         these, and from Android 14 a connectedDevice foreground service will
         not start at all without one of them: the service throws a
         SecurityException the moment it calls startForeground, which from
         outside looks like the app closing the instant the bridge is
         started. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Only so the access points in range can be listed inside the app. The
         system picker works without either of these, so the app asks and
         carries on when the answer is no.

         Two permissions for one job because Android changed its mind. Up to
         Android 12 the list of networks in range counts as location data and
         there is nothing to ask for but the location permission — and the
         location master switch has to be on as well, or the list comes back
         empty with no error at all. From Android 13 there is a permission that
         means what this actually wants, so that is the one asked for there and
         the location one is not shipped at all. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Partial only: the CPU stays up so the polling thread keeps running,
         the screen does not. Without it a recording stops when the screen
         does, which is when a drive actually starts. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- In-app updates: hands the release APK downloaded from GitHub to an
         installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- So the updater can list every app able to install a package - the
         system installer and any Shizuku-based one - from Android 11 on,
         where that list is otherwise filtered down to nothing. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:mimeType="application/vnd.android.package-archive" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.OpenDash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|uiMode|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the socket alive while the phone is in a pocket and the
             screen is off, which is the whole point of driving with it. -->
        <service
            android:name=".bridge.BridgeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- The same, for the app's own live session. The bridge had this from
             the start; the part that records a drive did not. -->
        <!-- Exposes the downloaded update (cacheDir/updates/) to the installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".data.LiveService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>
</manifest>
